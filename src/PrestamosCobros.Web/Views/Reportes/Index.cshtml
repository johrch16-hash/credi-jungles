@model IEnumerable<PrestamosCobros.BLL.DTOs.ClienteListDto>
@{
    ViewData["Title"] = "Generador de Estados de Cuenta";
}

<div class="fade-in pt-8 pb-20">
    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 mb-10">
        <div class="flex items-center gap-5">
            <div class="w-14 h-14 bg-primary-container text-white rounded-[22px] flex items-center justify-center soft-raised-sm">
                <span class="material-symbols-outlined text-3xl">description</span>
            </div>
            <div>
                <h1 class="text-2xl font-black text-primary-container tracking-tighter leading-none">Reportes</h1>
                <p class="text-[10px] font-bold text-secondary uppercase opacity-40 mt-1 tracking-widest">Generador Pro</p>
            </div>
        </div>
        <a href="@Url.Action("EstadoCuentaGeneral")" class="px-6 py-4 bg-white text-primary-container border border-slate-100 rounded-2xl text-[10px] font-black uppercase tracking-widest soft-card hover:soft-raised-sm transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-sm">folder_zip</span>
            Reporte General (PDF)
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Configuration Panel -->
        <div class="lg:col-span-5 space-y-8">
            <form asp-action="EstadoCuentaIndividual" method="get">
                <section class="soft-card bg-surface p-8 space-y-8">
                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-secondary uppercase opacity-40 ml-2 tracking-widest">Seleccionar Cliente</label>
                        <div class="relative group">
                            <select id="clienteSelect" name="clienteId" class="w-full bg-slate-50 border-none rounded-xl soft-recessed px-10 py-4 focus:ring-2 focus:ring-primary-container/10 text-sm font-bold text-primary-container appearance-none" required>
                                <option value="">-- Seleccionar un cliente --</option>
                                @foreach (var cliente in Model)
                                {
                                    <option value="@cliente.ClienteId">@cliente.NombreCompleto (@cliente.Telefono)</option>
                                }
                            </select>
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary opacity-30">person</span>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-secondary uppercase opacity-40 ml-2 tracking-widest">Rango de Fechas</label>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="soft-recessed bg-slate-50 rounded-xl px-4 py-3 flex flex-col">
                                <span class="text-[8px] uppercase font-black text-secondary opacity-30">Desde</span>
                                <input type="date" name="desde" class="bg-transparent border-none p-0 focus:ring-0 text-xs font-bold text-primary-container" />
                            </div>
                            <div class="soft-recessed bg-slate-50 rounded-xl px-4 py-3 flex flex-col">
                                <span class="text-[8px] uppercase font-black text-secondary opacity-30">Hasta</span>
                                <input type="date" name="hasta" class="bg-transparent border-none p-0 focus:ring-0 text-xs font-bold text-primary-container" />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-primary-container text-white py-5 rounded-2xl font-black uppercase tracking-widest text-[11px] soft-raised-sm active:soft-recessed transition-all flex items-center justify-center gap-3">
                        <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span>
                        Generar Estado de Cuenta
                    </button>
                </section>
            </form>

            <div class="p-6 bg-amber-50/50 border border-amber-100 rounded-2xl flex gap-4">
                <span class="material-symbols-outlined text-amber-500">info</span>
                <p class="text-[11px] font-bold text-amber-900/60 leading-relaxed uppercase tracking-tighter">
                    Este módulo genera un documento profesional con el desglose de pagos, intereses y saldo proyectado a la fecha de corte.
                </p>
            </div>
        </div>

        <!-- Preview Area -->
        <div class="lg:col-span-7 space-y-4">
            <div class="flex items-center justify-between px-4">
                <h2 class="text-[10px] font-black text-secondary uppercase opacity-40 tracking-widest">Vista Previa Pro</h2>
                <div class="flex gap-2">
                    <div class="w-2 h-2 rounded-full bg-slate-200"></div>
                    <div class="w-2 h-2 rounded-full bg-slate-200"></div>
                </div>
            </div>

            <!-- Virtual Document -->
            <div class="bg-white rounded-xl shadow-2xl p-6 sm:p-10 min-h-[600px] flex flex-col space-y-10 relative overflow-hidden border border-slate-100">
                <!-- Header -->
                <div class="flex justify-between items-start border-b border-slate-50 pb-8">
                    <div class="space-y-2">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-primary-container rounded-xl flex items-center justify-center text-white soft-raised-sm">
                                <span class="material-symbols-outlined">finance</span>
                            </div>
                            <span class="text-2xl font-black text-primary-container tracking-tighter">CREDIGEST</span>
                        </div>
                        <p class="text-[9px] font-bold text-secondary opacity-40 uppercase tracking-widest">Servicios Financieros Digitales</p>
                    </div>
                    <div class="text-right">
                        <h3 class="text-xs font-black text-primary-container uppercase tracking-widest">Estado de Cuenta</h3>
                        <p class="text-[9px] font-bold text-secondary opacity-40 mt-1">Ref: #PROY-@(DateTime.Now.Year)-V1</p>
                    </div>
                </div>

                <!-- Client Info -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <p class="text-[8px] font-black text-secondary uppercase opacity-30 tracking-widest">Para:</p>
                        <p id="previewNombre" class="text-sm font-black text-primary-container">Seleccione un cliente</p>
                        <p id="previewCedula" class="text-[10px] font-bold text-secondary opacity-60">ID: ---</p>
                    </div>
                    <div class="text-right space-y-1">
                        <p class="text-[8px] font-black text-secondary uppercase opacity-30 tracking-widest">Fecha de Generación:</p>
                        <p class="text-sm font-black text-primary-container">@DateTime.Now.ToString("dd MMM, yyyy")</p>
                    </div>
                </div>

                <!-- Balance Summary -->
                <div class="space-y-4 flex-grow">
                    <div class="bg-slate-50 p-6 rounded-2xl flex justify-between items-center">
                        <div>
                            <p class="text-[9px] font-black text-secondary uppercase opacity-30 tracking-widest">Saldo Pendiente</p>
                            <h4 id="previewSaldo" class="text-3xl font-black text-primary-container tracking-tighter mt-1">₡0.00</h4>
                        </div>
                        <div class="text-right">
                            <span class="px-4 py-1 bg-primary-container/10 text-primary-container text-[10px] font-black uppercase rounded-full tracking-widest">AL DÍA</span>
                        </div>
                    </div>

                    <div class="space-y-3 pt-4">
                        <p class="text-[9px] font-black text-secondary uppercase opacity-30 tracking-widest border-b border-slate-50 pb-2">Resumen de Movimientos</p>
                        <div id="movimientosContainer" class="space-y-4">
                            <p class="text-xs italic text-secondary opacity-30 text-center py-10">Sin datos para previsualizar</p>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="pt-8 border-t border-slate-50 text-center">
                    <p class="text-[9px] text-secondary opacity-30 italic leading-relaxed">
                        Este documento es una representación digital del estado financiero del cliente.<br>
                        Generado automáticamente por el sistema de gestión CrediGest.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('clienteSelect').addEventListener('change', function(e) {
            const id = e.target.value;
            if (!id) return;
            
            document.getElementById('previewNombre').innerText = "Cargando...";
            document.getElementById('previewCedula').innerText = "ID: ...";
            document.getElementById('previewSaldo').innerText = "₡ ---";
            document.getElementById('movimientosContainer').innerHTML = '<div class="flex justify-center py-10"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-container"></div></div>';

            fetch(`@Url.Action("GetClienteDetalle")?clienteId=${id}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('previewNombre').innerText = data.nombre;
                    document.getElementById('previewCedula').innerText = "ID: " + (data.cedula || "---");
                    document.getElementById('previewSaldo').innerText = "₡" + data.saldoTotal.toLocaleString();
                    
                    let html = '';
                    if (data.prestamos.length === 0) {
                        html = '<p class="text-xs italic text-secondary opacity-30 text-center py-10">Sin préstamos activos</p>';
                    } else {
                        data.prestamos.forEach(p => {
                            html += `
                                <div class="flex justify-between items-center py-2 border-b border-slate-50">
                                    <div>
                                        <p class="text-[10px] font-bold text-primary-container">Préstamo #${p.prestamoId}</p>
                                        <p class="text-[8px] text-secondary opacity-50">${p.estado}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-[10px] font-black text-primary-container">₡${p.saldoPendiente.toLocaleString()}</p>
                                        <p class="text-[8px] text-secondary opacity-50">${p.porcentajePagado}% pagado</p>
                                    </div>
                                </div>
                            `;
                        });
                    }
                    document.getElementById('movimientosContainer').innerHTML = html;
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById('previewNombre').innerText = "Error al cargar";
                });
        });
    </script>
}
