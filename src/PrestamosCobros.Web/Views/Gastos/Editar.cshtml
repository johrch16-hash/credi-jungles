@model PrestamosCobros.BLL.DTOs.GastoCreateDto
@{
    ViewData["Title"] = "Modificar Gasto";
}
<div class="space-y-10 pb-12 px-4">
    <!-- Header -->
    <div class="flex items-center gap-5">
        <div class="w-16 h-16 bg-rose-500 text-white rounded-[24px] flex items-center justify-center shadow-[8px_8px_20px_rgba(244,63,94,0.3)]">
            <span class="material-symbols-outlined text-4xl">edit</span>
        </div>
        <div>
            <h2 class="text-4xl font-black text-primary-container tracking-tighter">Modificar Gasto</h2>
            <p class="text-secondary text-sm font-bold opacity-60">Control operativo de egresos</p>
        </div>
    </div>

    <div class="max-w-xl">
        <div class="soft-card !p-10">
            <form asp-action="Editar" asp-route-id="@ViewData["GastoId"]" method="post" class="space-y-8">
                @Html.AntiForgeryToken()
                
                <div class="space-y-3">
                    <label asp-for="Descripcion" class="text-[11px] font-black uppercase tracking-[0.2em] text-primary-container px-3 opacity-60">Motivo del Gasto</label>
                    <input asp-for="Descripcion" class="soft-input !py-4" placeholder="Ej: Gasolina, Papelería..." />
                    <span asp-validation-for="Descripcion" class="text-rose-600 text-[10px] px-3 font-bold"></span>
                </div>

                <div class="space-y-3">
                    <label asp-for="Monto" class="text-[11px] font-black uppercase tracking-[0.2em] text-primary-container px-3 opacity-60">Monto Invertido (₡)</label>
                    <input asp-for="Monto" class="soft-input !py-4" type="number" step="0.01" min="0.01" placeholder="0.00" />
                    <span asp-validation-for="Monto" class="text-rose-600 text-[10px] px-3 font-bold"></span>
                </div>

                <div class="space-y-3">
                    <label asp-for="Categoria" class="text-[11px] font-black uppercase tracking-[0.2em] text-primary-container px-3 opacity-60">Categoría</label>
                    <select asp-for="Categoria" class="soft-input !py-4">
                        <option value="General">General</option>
                        <option value="Transporte">Transporte</option>
                        <option value="Comunicación">Comunicación</option>
                        <option value="Oficina">Oficina</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>

                <div class="space-y-3">
                    <label asp-for="Fecha" class="text-[11px] font-black uppercase tracking-[0.2em] text-primary-container px-3 opacity-60">Fecha del Gasto</label>
                    <input asp-for="Fecha" class="soft-input !py-4" type="date" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                </div>

                <div class="flex flex-col gap-5 pt-6 border-t-2 border-surface-container-low border-dashed">
                    <button type="submit" class="soft-button soft-button-primary !py-5 !rounded-2xl flex items-center justify-center gap-3 font-black text-xs tracking-widest shadow-xl">
                        <span class="material-symbols-outlined text-2xl">save</span>
                        GUARDAR CAMBIOS
                    </button>
                    <a href="@Url.Action("Index")" class="text-center text-[10px] font-black text-secondary uppercase tracking-[0.3em] opacity-40 hover:opacity-100 transition-opacity">
                        Cancelar y Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
