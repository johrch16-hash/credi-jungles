@model List<PrestamosCobros.BLL.DTOs.ClienteListDto>

<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Atrasos</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        No se encontraron clientes
                    </td>
                </tr>
            }
            @foreach (var c in Model)
            {
                var atrasoClass = c.NivelAtrasos switch
                {
                    0 => "badge-atraso-0",
                    1 => "badge-atraso-1",
                    2 => "badge-atraso-2",
                    _ => "badge-atraso-3"
                };
                <tr>
                    <td class="fw-medium">@c.NombreCompleto</td>
                    <td>@c.Telefono</td>
                    <td>
                        <span class="badge-atraso @atrasoClass">
                            <i class="bi bi-exclamation-triangle-fill"></i> @c.NivelAtrasos
                        </span>
                    </td>
                    <td>
                        <span class="badge-estado @(c.Estado == "Normal" ? "badge-normal" : "badge-bloqueado")">
                            @c.Estado
                        </span>
                    </td>
                    <td class="text-end">
                        <a href="@Url.Action("Detalle", new { id = c.ClienteId })" class="btn btn-sm btn-outline-secondary" title="Ver perfil">
                            <i class="bi bi-eye"></i>
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a href="@Url.Action("Editar", new { id = c.ClienteId })" class="btn btn-sm btn-outline-secondary" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
