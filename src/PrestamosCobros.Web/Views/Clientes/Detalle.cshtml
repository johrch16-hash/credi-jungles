@model PrestamosCobros.BLL.DTOs.ClienteDetalleDto
<div class="space-y-10 pb-24 px-4">
    <!-- Header: Profile -->
    <div class="soft-card !p-10 relative overflow-hidden">
        <!-- Contenedor relativo para el contenido z-10 -->
        
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8 relative z-10">
            <div class="w-24 h-24 rounded-[32px] bg-surface flex items-center justify-center soft-raised shadow-xl text-primary-container">
                <span class="material-symbols-outlined text-6xl">person</span>
            </div>
            
            <div class="flex-1 text-center md:text-left space-y-2">
                <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-4">
                    <h2 class="text-4xl font-black text-primary-container tracking-tighter">@Model.NombreCompleto</h2>
                    @if (User.IsInRole("Admin") || User.IsInRole("Asistente"))
                    {
                        <a href="@Url.Action("Editar", "Clientes", new { id = Model.ClienteId })" class="soft-button !py-3 !px-5 !rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2" style="background: var(--color-surface); color: var(--color-primary-container);">
                            <span class="material-symbols-outlined text-sm">edit</span>
                            Editar Perfil
                        </a>
                    }
                    @if (User.IsInRole("Master"))
                    {
                        <form method="post" action="@Url.Action("EliminarPermanente", "Clientes")" onsubmit="return confirm('¿Está seguro de que desea eliminar este cliente permanentemente? Se eliminarán también sus créditos y cuotas.');" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.ClienteId" />
                            <button type="submit" class="soft-button !py-3 !px-5 !rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center gap-2 bg-rose-100 text-rose-700 hover:bg-rose-200 transition-colors">
                                <span class="material-symbols-outlined text-sm">delete_forever</span>
                                Eliminar
                            </button>
                        </form>
                    }
                </div>
                <div class="flex flex-wrap justify-center md:justify-start gap-4">
                    <div class="flex items-center gap-2 opacity-60">
                        <span class="material-symbols-outlined text-lg">location_on</span>
                        <span class="text-sm font-bold">@Model.Direccion</span>
                    </div>
                    <div class="soft-badge @(Model.Estado == "Activo" ? "bg-emerald-100 text-emerald-700" : "bg-primary-container/10 text-primary-container") uppercase text-[9px] font-black tracking-widest">
                        @Model.Estado
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Action Row -->
        <div class="mt-8 flex justify-start">
            <button type="button" onclick="openWhatsAppModal()" class="w-full md:w-auto soft-button !py-4 !px-8 !rounded-2xl text-xs font-black uppercase tracking-widest flex items-center justify-center gap-3 bg-gradient-to-r from-[#25D366] to-[#1DA851] text-white shadow-lg hover:shadow-xl hover:scale-105 transition-all">
                <span class="material-symbols-outlined text-xl">forum</span>
                Enviar Mensaje WhatsApp
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mt-12 pt-10 border-t-2 border-surface-container-low border-dashed">
            <div class="space-y-2">
                <p class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40">Contacto Directo</p>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface flex items-center justify-center soft-recessed-sm text-primary-container">
                        <span class="material-symbols-outlined text-xl">call</span>
                    </div>
                    <span class="text-base font-black text-primary-container">@Model.Telefono</span>
                </div>
            </div>

            <div class="space-y-2">
                <p class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40">Correo Electrónico</p>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface flex items-center justify-center soft-recessed-sm text-primary-container">
                        <span class="material-symbols-outlined text-xl">mail</span>
                    </div>
                    <span class="text-base font-black text-primary-container break-all">@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</span>
                </div>
            </div>
            
            <div class="space-y-2">
                <p class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40">Identificación</p>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface flex items-center justify-center soft-recessed-sm text-primary-container">
                        <span class="material-symbols-outlined text-xl">fingerprint</span>
                    </div>
                    <span class="text-base font-black text-primary-container">@Model.CedulaEnmascarada</span>
                </div>
            </div>

            <div class="space-y-2">
                <p class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40">Centro Laboral</p>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-surface flex items-center justify-center soft-recessed-sm text-primary-container">
                        <span class="material-symbols-outlined text-xl">work</span>
                    </div>
                    <span class="text-base font-black text-primary-container">@Model.LugarTrabajo</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Loans Section -->
    <div class="space-y-6">
        <div class="flex items-center justify-between px-4 flex-wrap gap-4">
            <div class="flex items-center gap-4">
                <h3 class="text-2xl font-black text-primary-container tracking-tighter">Cartera de Créditos</h3>
                <span class="soft-badge bg-surface text-primary-container font-black">ACTIVOS</span>
            </div>
            @if (Model.Prestamos.Any(x => x.Estado == "Liquidado" || x.Estado == "Renovado"))
            {
                <a href="@Url.Action("Historial", "Clientes", new { id = Model.ClienteId })" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-600 text-xs font-black uppercase tracking-wider hover:bg-slate-200 transition-colors flex items-center gap-2 border border-slate-200/50">
                    <span class="material-symbols-outlined text-sm">history</span> HISTORIAL DE CRÉDITOS
                </a>
            }
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var p in Model.Prestamos.Where(x => x.Estado != "Liquidado" && x.Estado != "Renovado"))
            {
                <div class="soft-card !p-8 group hover:soft-raised-sm transition-all border-l-8 border-primary-container">
                    <div class="flex justify-between items-start mb-8">
                        <div class="space-y-1">
                            <span class="text-[9px] font-black text-secondary uppercase tracking-widest opacity-40">Expediente</span>
                            <h4 class="text-xl font-black text-primary-container">
                                #@p.PrestamoId.ToString("D5")
                                @if (!string.IsNullOrEmpty(p.NombreAlias))
                                {
                                    <span class="text-sm font-black text-primary-container block mt-1">@p.NombreAlias</span>
                                }
                            </h4>
                        </div>
                        <span class="soft-badge bg-primary-container/5 text-primary-container text-[9px] font-black uppercase">@p.Estado</span>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-8">
                        <div class="soft-recessed p-4 rounded-2xl">
                            <p class="text-[8px] font-black text-secondary uppercase tracking-widest opacity-40 mb-1">Monto Original</p>
                            <p class="text-sm font-black text-primary-container">₡@p.MontoPrestado.ToString("N0")</p>
                        </div>
                        <div class="soft-recessed p-4 rounded-2xl">
                            <p class="text-[8px] font-black text-secondary uppercase tracking-widest opacity-40 mb-1">Saldo Actual</p>
                            <p class="text-sm font-black text-rose-600">₡@p.SaldoPendiente.ToString("N0")</p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <div class="flex justify-between items-end">
                            <span class="text-[9px] font-black text-secondary uppercase tracking-widest opacity-40">Amortización</span>
                            <span class="text-xs font-black text-primary-container">@p.PorcentajePagado%</span>
                        </div>
                        <div class="w-full h-2 bg-surface rounded-full soft-recessed-sm overflow-hidden">
                            <div class="h-full bg-primary-container rounded-full" style="width: @p.PorcentajePagado%"></div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-surface-container-low flex justify-between items-center">
                        <a href="@Url.Action("Detalle", "Prestamos", new { id = p.PrestamoId })" class="flex items-center justify-center gap-2 text-[10px] font-black text-primary-container uppercase tracking-[0.2em] hover:gap-4 transition-all">
                            GESTIONAR CRÉDITO <span class="material-symbols-outlined text-lg">arrow_forward</span>
                        </a>

                        @if (User.IsInRole("Master"))
                        {
                            <form method="post" action="@Url.Action("Eliminar", "Prestamos")" onsubmit="return confirm('¿Está seguro de que desea eliminar permanentemente este crédito? Esta acción no se puede deshacer.');" class="inline m-0 p-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.PrestamoId" />
                                <button type="submit" class="w-8 h-8 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center hover:bg-rose-100 hover:text-rose-700 transition-colors" title="Eliminar Crédito">
                                    <span class="material-symbols-outlined text-sm">delete</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Pending Cuotas Table -->
    @if (Model.CuotasPendientes.Any())
    {
        <div class="space-y-8">
            <div class="flex items-center justify-between px-4">
                <h3 class="text-2xl font-black text-primary-container tracking-tighter">Cuotas Pendientes</h3>
                <span class="soft-badge bg-rose-50 text-rose-600 font-black">POR COBRAR</span>
            </div>

            @foreach (var grupo in Model.CuotasPendientes.GroupBy(x => x.PrestamoId))
            {
                var prestamoId = grupo.Key;
                var prestamoAlias = grupo.FirstOrDefault()?.PrestamoAlias;
                var prestamoLabel = !string.IsNullOrEmpty(prestamoAlias) 
                    ? $"{prestamoAlias} (#{prestamoId.ToString("D5")})" 
                    : $"Expediente #{prestamoId.ToString("D5")}";

                <div class="space-y-3">
                    <div class="px-4">
                        <h4 class="text-xs font-black text-secondary uppercase tracking-widest">
                            Crédito: <span class="text-primary-container font-black">@prestamoLabel</span>
                        </h4>
                    </div>

                    <div class="soft-card overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="text-left bg-surface-container-low/30">
                                        <th class="px-6 py-4 text-[9px] font-black text-secondary uppercase tracking-widest opacity-40">Vencimiento</th>
                                        <th class="px-6 py-4 text-[9px] font-black text-secondary uppercase tracking-widest opacity-40">Monto</th>
                                        <th class="px-6 py-4 text-[9px] font-black text-secondary uppercase tracking-widest opacity-40">Estado</th>
                                        <th class="px-6 py-4 text-[9px] font-black text-secondary uppercase tracking-widest opacity-40 text-center">Notificar</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-surface-container-low">
                                    @foreach (var c in grupo.OrderBy(cu => cu.FechaVencimiento))
                                    {
                                        var esAtrasada = c.FechaVencimiento < DateTime.UtcNow;
                                        <tr class="hover:bg-surface-container-low/20 transition-colors">
                                            <td class="px-6 py-4">
                                                <div class="flex flex-col">
                                                    <span class="text-xs font-black text-primary-container">@c.FechaVencimiento.ToString("dd MMM, yyyy")</span>
                                                    @if (esAtrasada)
                                                    {
                                                        <span class="text-[9px] font-black text-rose-600 uppercase tracking-widest">Atrasada</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-xs font-black text-primary-container">₡@c.Monto.ToString("N2")</td>
                                            <td class="px-6 py-4">
                                                <span class="soft-badge @(esAtrasada ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-700") uppercase text-[8px] font-black">
                                                    @c.Estado
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <div class="flex items-center justify-center gap-2">
                                                    <button type="button" class="btn-notificar-whatsapp w-10 h-10 rounded-xl bg-[#25D366] text-white inline-flex items-center justify-center shadow-lg hover:scale-110 transition-transform" data-cuota-id="@c.CuotaId" title="Notificar por WhatsApp">
                                                        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                                                    </button>
                                                    <button type="button" class="btn-notificar-email w-10 h-10 rounded-xl bg-primary text-white inline-flex items-center justify-center shadow-lg hover:scale-110 transition-transform" data-cuota-id="@c.CuotaId" title="Notificar por Correo Electrónico">
                                                        <span class="material-symbols-outlined text-xl">mail</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@Html.AntiForgeryToken()
@section Scripts {
    <script>
        document.addEventListener('click', async (e) => {
            const btnWhatsapp = e.target.closest('.btn-notificar-whatsapp');
            const btnEmail = e.target.closest('.btn-notificar-email');
            
            if (btnWhatsapp) {
                const cuotaId = btnWhatsapp.getAttribute('data-cuota-id');
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                btnWhatsapp.disabled = true;
                const originalContent = btnWhatsapp.innerHTML;
                btnWhatsapp.innerHTML = '<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

                try {
                    const formData = new URLSearchParams();
                    formData.append('cuotaId', cuotaId);
                    formData.append('__RequestVerificationToken', token);
                    
                    const response = await fetch('/Notificaciones/EnviarManual', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        alert(data.message);
                    } else {
                        alert('Error: ' + data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error de conexión');
                } finally {
                    btnWhatsapp.disabled = false;
                    btnWhatsapp.innerHTML = originalContent;
                }
            }

            if (btnEmail) {
                const cuotaId = btnEmail.getAttribute('data-cuota-id');
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                btnEmail.disabled = true;
                const originalContent = btnEmail.innerHTML;
                btnEmail.innerHTML = '<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

                try {
                    const formData = new URLSearchParams();
                    formData.append('cuotaId', cuotaId);
                    formData.append('__RequestVerificationToken', token);
                    
                    const response = await fetch('/Notificaciones/EnviarCorreoManual', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        alert(data.message);
                    } else {
                        alert('Error: ' + data.message);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Error de conexión o el cliente no tiene correo registrado.');
                } finally {
                    btnEmail.disabled = false;
                    btnEmail.innerHTML = originalContent;
                }
            }
        });

        function openWhatsAppModal() {
            document.getElementById('wa-modal').classList.remove('hidden');
            document.getElementById('wa-mensaje').value = '';
            document.getElementById('wa-mensaje').focus();
        }

        function closeWhatsAppModal() {
            document.getElementById('wa-modal').classList.add('hidden');
        }

        async function sendWhatsAppMessage() {
            const text = document.getElementById('wa-mensaje').value.trim();
            if (!text) { alert('El mensaje no puede estar vacío.'); return; }
            
            const btn = document.getElementById('btn-send-wa');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined animate-spin">sync</span> ENVIANDO...';
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new URLSearchParams();
            formData.append('clienteId', '@Model.ClienteId');
            formData.append('mensaje', text);
            formData.append('__RequestVerificationToken', token);
            
            try {
                const res = await fetch('@Url.Action("EnviarMensajeTexto", "Clientes")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });
                
                const data = await res.json();
                if (data.success) {
                    alert('Mensaje enviado correctamente.');
                    closeWhatsAppModal();
                } else {
                    alert('Error al enviar el mensaje: ' + data.message);
                }
            } catch (e) {
                alert('Error de conexión.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    </script>
}

<!-- WhatsApp Message Modal -->
<div id="wa-modal" class="fixed inset-0 bg-black/60 z-[9999] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md overflow-hidden shadow-2xl relative">
        <div class="bg-[#25D366] text-white p-6">
            <h3 class="text-xl font-black flex items-center gap-2">
                <span class="material-symbols-outlined">chat</span> Enviar Mensaje
            </h3>
        </div>
        <div class="p-6 space-y-4">
            <textarea id="wa-mensaje" rows="4" class="w-full p-4 rounded-xl bg-slate-50 border-0 focus:ring-2 focus:ring-[#25D366] text-sm" placeholder="Escribe el mensaje que deseas enviar al cliente..."></textarea>
            <button type="button" onclick="sendWhatsAppMessage()" id="btn-send-wa" class="w-full py-4 bg-[#25D366] text-white font-black rounded-xl hover:bg-[#20bd5a] transition-colors flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">send</span> ENVIAR MENSAJE
            </button>
        </div>
        <button class="absolute top-4 right-4 text-white/80 hover:text-white" onclick="closeWhatsAppModal()">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
</div>

<!-- Floating Action Button -->
<a href="@Url.Action("Crear", "Prestamos", new { clienteId = Model.ClienteId })" class="fixed bottom-32 lg:bottom-10 right-6 lg:right-10 soft-button soft-button-primary !w-20 !h-20 !rounded-[28px] !p-0 flex items-center justify-center shadow-2xl group transition-all hover:scale-110 active:scale-95 z-50">
    <span class="material-symbols-outlined text-4xl group-hover:rotate-90 transition-transform">add_card</span>
</a>
