@model PrestamosCobros.BLL.DTOs.UsuarioCreateDto
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="fade-in pb-20">
    <div class="flex items-center gap-5 mb-10">
        <a href="@Url.Action("Index")" class="w-12 h-12 bg-white border border-slate-100 rounded-[18px] flex items-center justify-center text-secondary hover:text-primary-container transition-all">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <div>
            <h1 class="text-2xl font-black text-primary-container tracking-tighter leading-none">Nuevo Usuario</h1>
            <p class="text-[10px] font-bold text-secondary uppercase opacity-40 mt-1 tracking-widest">Registrar personal</p>
        </div>
    </div>

    <div class="soft-card max-w-2xl">
        <form asp-action="Crear" method="post" class="space-y-8">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-rose-500 text-[11px] font-bold uppercase tracking-wider bg-rose-50 p-4 rounded-2xl mb-6"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-2">
                    <label asp-for="NombreCompleto" class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40 ml-1">Nombre Completo</label>
                    <input asp-for="NombreCompleto" class="soft-input w-full" placeholder="Ej: Juan Pérez" />
                    <span asp-validation-for="NombreCompleto" class="text-rose-500 text-[10px] font-bold"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Email" class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40 ml-1">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="soft-input w-full" placeholder="correo@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-rose-500 text-[10px] font-bold"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Password" class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40 ml-1">Contraseña Temporal</label>
                    <input asp-for="Password" type="password" class="soft-input w-full" placeholder="••••••••" />
                    <p class="text-[9px] font-bold text-secondary opacity-30 mt-1">Mínimo 8 caracteres (A-z, 0-9)</p>
                    <span asp-validation-for="Password" class="text-rose-500 text-[10px] font-bold"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Rol" class="text-[10px] font-black text-secondary uppercase tracking-widest opacity-40 ml-1">Rol del Sistema</label>
                    <select asp-for="Rol" class="soft-input w-full appearance-none">
                        <option value="Asistente">Asistente</option>
                        <option value="Cobrador">Cobrador</option>
                        <option value="Admin">Administrador</option>
                    </select>
                </div>
            </div>

            <div class="pt-8 border-t border-slate-50 flex gap-4">
                <button type="submit" class="flex-1 py-4 bg-primary-container text-white rounded-[20px] text-[11px] font-black uppercase tracking-widest soft-raised-sm active:soft-recessed-sm transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">person_add</span>
                    Crear Usuario
                </button>
                <a href="@Url.Action("Index")" class="px-8 py-4 bg-slate-50 text-secondary rounded-[20px] text-[11px] font-black uppercase tracking-widest hover:bg-slate-100 transition-all flex items-center justify-center">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
